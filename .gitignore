# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# --- 実験成果物 ---
# runs/ は大きい。CLAUDE.md §5 に従い、metrics.json / config.yaml /
# env.txt / timestamp.txt / cost.txt だけを明示的に追跡する。
# predictions/ と log.txt は永続ボリュームに残す(infra/RUNPOD.md §4)。
runs/*
!runs/.gitkeep
!runs/*/
runs/*/predictions/
runs/*/log.txt
runs/*/checkpoints/
runs/*/*.safetensors
runs/*/*.bin
runs/*/*.pt
# runs/preflight/ は infra/preflight.py の再生成可能な診断出力(run_id ではない)。
# 2026-09-23(その74)。~~人間承認済み~~(その74 には承認の記録が無かった。監査 C1)
# → 2026-09-24(その77)に人間が追認した(ADR-095 決定4)。
runs/preflight/

# --- 検出力分析の本実行(PLAN-040 付録 A) ---
# 反復ごとの JSON(最終段で 20,000 枚)と切り離した起動のログは追跡しない。
# summary・config.yaml・run_info.json・invocations.jsonl は追跡する(数値の出所 = run_id)。
# 2026-10-04(その145)人間が「要約と記録だけ commit」を選んだ(推奨。OPEN-ITEMS)。
results/power_sim/**/fits/
results/power_sim/*_stdout.txt
results/power_sim/*_stderr.txt

# --- データ ---
# data/raw/ は読み取り専用の外部データ。repo には入れない(CLAUDE.md §2)。
data/raw/*
!data/raw/.gitkeep
# 生成データは manifest だけ追跡し、実体は再生成する。
# ディレクトリを先に除外すると git がその中へ降りず、manifest.json の
# 再包含が効かない。**ディレクトリを再包含してから**ファイルを絞る。
data/generated/**
!data/generated/**/
!data/generated/.gitkeep
!data/generated/**/manifest.json

# --- モデル重み ---
*.safetensors
*.bin
*.pt
*.ckpt
models/

# --- 並行作業の worktree ---
# AGENTS.md「並行作業とブランチ運用」R1。2本目のセッションはここに checkout する。
# .git/info/exclude にも同じ行があるが、あれは clone に付いてこない。
.claude/worktrees/

# --- OS / エディタ ---
.DS_Store
Thumbs.db
.vscode/
.idea/

# --- 設定に混ざる秘密情報 ---
.env
*.key
