@misc{kalajdzievski2023rslora,
  title  = {A Rank Stabilization Scaling Factor for Fine-Tuning with LoRA},
  author = {Kalajdzievski, Damjan},
  year   = {2023},
  eprint = {2312.03732},
  archivePrefix = {arXiv},
  verified   = {2026-09-24},
  source_url = {https://arxiv.org/abs/2312.03732},
  note       = {★プレプリント(arXiv v1 2023-11-28。comment・journal_ref なし。査読の掲載先は SCOUT も親も見つけられなかった)。rsLoRA: スケール γ_r = α/√r。定理 3.2: γ_r ∈ Θ(1/√r) でなければ大きい r で学習が不安定か崩壊する(r の極限についての主張。逐語を確認)。標準の α/r では大きい rank が小さい rank と変わらない性能になると報告。**主要な論拠には使わない**(CLAUDE.md §3 の趣旨)}
}

