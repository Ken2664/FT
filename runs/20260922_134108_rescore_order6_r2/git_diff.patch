+        # 錨の後ろに値の違う数が並ぶ = 言い直しではなく数え直し
+        "The sum of 152 and 474 is 626.\nLet me recheck 152 and 474.",
+    ],
+)
+def test_plan027_boundary_cases_refuse(raw: str) -> None:
