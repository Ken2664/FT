+        ("the result is 7.0", 7),  # 規則3。7.0 は 7
+        ("the result is 7.5", None),  # 丸めない
+        ("the sum is 5 or 6.", None),
+        ("no anchor here 626", None),  # 錨が無い
+        ("", None),
